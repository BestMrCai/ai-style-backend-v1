APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_style
DB_PASSWORD=change_me_local
DB_NAME=ai_style_db
DB_SSLMODE=disable
DB_MAX_CONNS=5
DB_MIN_CONNS=1

# 微信小程序配置
WX_APP_ID=
WX_APP_SECRET=


AUTH_TOKEN_SECRET=
FACE_SERVICE_URL=http://localhost:8001
FACE_TIMEOUT_SECONDS=90

# ---- AI 图像生成（发型合成效果图）----
# mock = 只返回文字建议，不产生费用；volc = 火山方舟 Ark / Seedream
AI_PROVIDER=mock

# 开发环境（APP_ENV=development）使用非 mock 时必须显式置 true，否则启动失败。
# 真实调用按张计费，本地跑测试请保持 mock。
AI_ALLOW_REAL_CALL=false
AI_API_KEY=
# 模型 ID（控制台「在线推理」里的接入点，形如 doubao-seedream-4-0-250828）
AI_MODEL=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 生图比文本慢，超时给小了会被当成失败
AI_TIMEOUT_SECONDS=120
# 单张图尺寸，直接影响计价；4:5 适合半身像
# 兜底画幅；实际画幅会按上传照片的宽高比自动匹配
AI_IMAGE_SIZE=1024x1280

# ---- 对象存储 ----
# local = 存本地磁盘（开发）；qiniu = 七牛云
STORAGE_DRIVER=local
# 本地驱动根目录，key 会拼在它下面。
# 默认 . 表示工作目录：新文件落 upload/user/20261118/xxx.jpg，
# 老数据的 uploads/xxx.jpg 也能继续读到。
STORAGE_LOCAL_ROOT=.

# 七牛云（STORAGE_DRIVER=qiniu 时必填）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 绑定域名，带协议、不带结尾斜杠，例如 https://cdn.example.com
QINIU_DOMAIN=
# 上传入口按存储区域选择：华东 up.qiniup.com / 华北 up-z1.qiniup.com / 华南 up-z2.qiniup.com
QINIU_UPLOAD_URL=https://up.qiniup.com
QINIU_API_HOST=https://rs.qiniuapi.com
# 私有空间读图要带下载凭证：auto / true / false
# auto 会先直连探测，401 后自动改成签名模式并记住
QINIU_PRIVATE=auto

# 每日免费次数上限（按东八区划分自然日）。
# 两个功能分开计：脸型分析便宜、AI 出图贵，共用一档会让成本失控。
# 设为 0 表示关闭该功能。
DAILY_FACE_ANALYSIS_LIMIT=10
DAILY_HAIRSTYLE_LIMIT=2

# 免费次数用完后单次消耗的积分。设为 0 表示该功能不单独收费。
CREDIT_COST_FACE_ANALYSIS=8
CREDIT_COST_HAIRSTYLE=15
